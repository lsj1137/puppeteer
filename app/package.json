{
  "name": "agent-workspace",
  "version": "0.0.6",
  "description": "멀티프로젝트 AI 에이전트 워크스페이스",
  "author": "lsj1137",
  "main": "./out/main/index.js",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "node ./scripts/run-electron-vite.mjs dev",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "smoke": "npm run build && npm run smoke:run",
    "smoke:run": "node ./scripts/smoke-electron.mjs",
    "e2e": "npm run build && npm run e2e:run",
    "e2e:run": "node ./scripts/e2e-electron.mjs",
    "start": "node ./scripts/run-electron-vite.mjs preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "verify": "npm test && npm run build && npm run smoke:run && npm run e2e:run",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run verify && electron-builder",
    "dist:win": "npm run verify && electron-builder --win nsis --x64",
    "dist:mac": "npm run verify && electron-builder --mac dmg zip --universal",
    "publish:win": "npm run verify && electron-builder --win nsis --x64 --publish always",
    "publish:mac": "npm run verify && electron-builder --mac dmg zip --universal --publish always"
  },
  "build": {
    "appId": "com.lsj1137.puppeteer",
    "productName": "Puppeteer",
    "directories": {
      "buildResources": "resources",
      "output": "dist_electron"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/hooks",
        "to": "hooks",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/icon.png",
        "to": "app-icon.png"
      },
      {
        "from": "resources/icon.ico",
        "to": "app-icon.ico"
      }
    ],
    "asar": true,
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Puppeteer-${version}-Setup-${arch}.${ext}"
    },
    "mac": {
      "forceCodeSigning": true,
      "icon": "icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "Puppeteer-${version}-mac-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Puppeteer"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lsj1137",
        "repo": "puppeteer",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "konva": "^10.3.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-konva": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
